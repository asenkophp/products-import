# ===== Приложение =====
# окружение: dev | prod
APP_ENV=dev
# 1 — подробные ошибки в ответах API (в prod ставить 0)
APP_DEBUG=1
# порт nginx на хосте: http://localhost:8080
APP_PORT=8080
# собранный фронтенд в Docker: http://localhost:8081
FRONTEND_PORT=8081

# ===== Права на файлы в dev (UID/GID вашего пользователя, узнать: id) =====
UID=1000
GID=1000

# ===== PostgreSQL =====
DB_HOST=db
DB_PORT=5432
DB_NAME=products
DB_USER=app
DB_PASSWORD=secret
# порт БД на хосте для DBeaver/PhpStorm (только localhost)
DB_HOST_PORT=5433

# ===== RabbitMQ =====
RABBITMQ_USER=app
RABBITMQ_PASSWORD=secret
# веб-интерфейс RabbitMQ: http://localhost:15672
RABBITMQ_UI_PORT=15672
# DSN транспорта Symfony Messenger
MESSENGER_TRANSPORT_DSN=amqp://app:secret@rabbitmq:5672/%2f/messages

# ===== Аутентификация =====
# секрет подписи JWT, не короче 32 символов (на сервере обязательно сгенерируйте свой: openssl rand -hex 32)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef0123456789
# время жизни токена в секундах (8 часов)
JWT_TTL=28800
# пользователь, которого создаёт make init / make user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
